{
  "name": "maem-recipe-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .wrangler",
    "cloudinary:export": "node scripts/cloudinary-assets.mjs export",
    "cloudinary:delete": "node scripts/cloudinary-assets.mjs delete"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "gsap": "^3.15.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "^8.2.1"
  },
  "type": "module"
}
